# Docker Compose reads this file. Local Python uses defaults / exported shell variables.
# Local teaching starter only. Do not expose the demo accounts to the Internet.
DEMO_MODE=true
DATABASE_URL=sqlite:///./campuscomp.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The starter sends in-app notifications only. External AI / email are disabled.
AI_PROVIDER=rules
EMAIL_PROVIDER=disabled
POSTGRES_PASSWORD=campuscomp-local-only
